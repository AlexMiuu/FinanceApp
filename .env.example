# Copy to .env — docker compose picks it up automatically. All values optional in dev.

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/v1/auth/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PKCS#8 RSA private key (PEM) for signing access tokens.
# Leave empty in dev: an ephemeral key is generated at startup.
# Generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
AUTH_JWT_PRIVATE_KEY_PEM=
