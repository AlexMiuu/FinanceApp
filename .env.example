# Copy to .env — docker compose picks it up automatically.
#
# Everything below is optional for local development (docker-compose.yml).
# The block marked REQUIRED FOR DEPLOYMENT must be filled in before running
# docker-compose.prod.yml; that file fails fast rather than starting insecurely.

# ── Local development ────────────────────────────────────────────────────────

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/v1/auth/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PKCS#8 RSA private key (PEM) for signing access tokens.
# Leave empty in dev: an ephemeral key is generated at startup.
# Generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
AUTH_JWT_PRIVATE_KEY_PEM=


# ── REQUIRED FOR DEPLOYMENT (docker-compose.prod.yml) ────────────────────────

# The domain whose A record points at this server. Caddy requests a certificate
# for exactly this name, so a typo shows up as a certificate that never arrives.
ARGALI_DOMAIN=argali.example.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# Postgres. There is no default: the development password is "finance", and
# shipping that to a public server would be handing over the ledger.
POSTGRES_USER=finance
POSTGRES_PASSWORD=

# RabbitMQ. The image's built-in guest/guest only works from localhost, but the
# broker is on the internal network anyway — set a real password regardless.
RABBITMQ_USER=argali
RABBITMQ_PASSWORD=

# Signing key — REQUIRED in production, unlike in dev. Without it a new key is
# generated at every boot, so every restart silently signs you out.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | tr '\n' '~'
# then paste, replacing ~ with \n, or keep the PEM on one line however your
# shell prefers. Compose passes it through verbatim.
# (reuses AUTH_JWT_PRIVATE_KEY_PEM above)

# Whether strangers can create accounts. Leave false for a personal deployment;
# set true briefly to register yourself the first time, then set it back.
AUTH_REGISTRATION_ENABLED=false

# Images. Defaults to this repository's GHCR path; TAG follows the branch or
# tag that the publish-images workflow built.
# REGISTRY=ghcr.io/alexmiuu/financeapp
# TAG=dev

# Memory. Defaults suit an 8 GB host. On 4 GB, drop to roughly:
#   SERVICE_MEM_LIMIT=420m
#   JVM_OPTS=-XX:MaxRAMPercentage=60 -XX:+UseSerialGC
# SERVICE_MEM_LIMIT=700m
# JVM_OPTS=-XX:MaxRAMPercentage=70 -XX:+UseSerialGC
